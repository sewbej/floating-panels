{
  "layout": {
    "type": "layout",
    "pages": [
      "page1",
      "page2"
    ],
    "page1": {
      "type": "page",
      "title": "Settings",
      "sections": [
        "section-general",
        "section-appearance",
        "section-radius",
        "section-gap-size",
        "section-filters"
      ]
    },
    "page2": {
      "type": "page",
      "title": "About",
      "sections": [
        "section-about"
      ]
    },
    "section-general": {
      "type": "section",
      "title": "Appearance",
      "keys": [
        "panel-theme",
        "background-gradient-start",
        "background-gradient-end",
        "border-color",
        "panel-theme-predefined",
        "opacity-level"
      ]
    },
    "section-appearance": {
      "type": "section",
      "title": "",
      "keys": [
        "border-thickness",
        "panel-shadow",
        "panel-style"
      ]
    },
    "section-radius": {
      "type": "section",
      "title": "",
      "keys": [
        "border-radius"
      ]
    },
    "section-gap-size": {
      "type": "section",
      "title": "",
      "keys": [
        "gap-size"
      ]
    },
    "section-filters": {
      "type": "section",
      "title": "Behavior",
      "keys": [
        "window-maximized",
        "filters-description",
        "panel-height"
      ]
    },
    "section-about": {
      "type": "section",
      "title": "Information",
      "keys": [
        "about-label",
        "website_btn",
        "issue_btn",
        "donate_btn"
      ]
    }
  },
  "panel-theme": {
    "type": "combobox",
    "default": "-custom",
    "description": "Panel color scheme",
    "options": {
      "Custom": "-custom",
      "Predefined": "predefined"
    }
  },
  "panel-theme-predefined": {
    "type": "combobox",
    "default": "-semabe-steel",
    "description": "Color scheme",
    "dependency": "panel-theme=predefined",
    "options": {
      "Mint-Y": "-mint-y",
      "Mint-Y-Dark": "-mint-y-dark",
      "Semabe Azure": "-semabe-azure",
      "Semabe Cinnamon": "-semabe-cinnamon",
      "Semabe Crimson": "-semabe-crimson",
      "Semabe Falcon": "-semabe-falcon",
      "Semabe Grey": "-semabe-grey",
      "Semabe Mint": "-semabe-mint",
      "Semabe Nordic": "-semabe-nordic",
      "Semabe Steel": "-semabe-steel",
      "Semabe Violet": "-semabe-violet"
    }
  },
  "background-gradient-start": {
    "type": "colorchooser",
    "default": "rgba(255,255,255,1.0)",
    "dependency": "panel-theme=-custom",
    "description": "Gradient start color"
  },
  "background-gradient-end": {
    "type": "colorchooser",
    "default": "rgba(154,153,150,1.0)",
    "dependency": "panel-theme=-custom",
    "description": "Gradient end color"
  },
  "border-color": {
    "type": "colorchooser",
    "default": "rgba(0,0,0,1.0)",
    "dependency": "panel-theme=-custom",
    "description": "Border color"
  },
  "opacity-level": {
    "type": "scale",
    "description": "Opacity",
    "dependency": "panel-theme=predefined",
    "show-value": false,
    "min": 0,
    "max": 1,
    "step": 0.1,
    "default": 1
  },
  "border-radius": {
    "type": "scale",
    "description": "Corner radius",
    "show-value": true,
    "min": 0,
    "max": 36,
    "step": 1,
    "default": 12
  },
  "panel-shadow": {
    "type": "colorchooser",
    "default": "rgba(0,0,0,0.0)",
    "description": "Panel shadow color"
  },
  "border-thickness": {
    "type": "spinbutton",
    "description": "Border width",
    "min": 0,
    "max": 6,
    "step": 1,
    "default": 1
  },
  "panel-style": {
    "type": "combobox",
    "default": "panel-normal",
    "description": "Panel style",
    "options": {
      "Normal": "panel-normal",
      "Dock": "panel-dock",
      "Two-piece": "panel-two-piece",
      "Three-piece": "panel-three-piece"
    }
  },
  "gap-size": {
    "type": "scale",
    "description": "Gap size",
    "show-value": true,
    "min": 4,
    "max": 20,
    "step": 1,
    "default": 10
  },
  "window-maximized": {
    "type": "switch",
    "default": false,
    "description": "Disable floating panel when a window is maximized",
    "tooltip": ""
  },
  "panel-height": {
    "type": "scale",
    "description": "                                        Panel height when a window is maximized\nsmall                                                                                                                        same as floating",
    "dependency": "window-maximized",
    "show-value": false,
    "min": 0,
    "max": 100,
    "step": 1,
    "default": 100
  },
  "filters-description": {
    "type": "label",
    "dependency": "window-maximized",
    "description": "Cinnamon's panel height setting is locked while this option is on. Turn it off to change the panel height."
  },
  "about-label": {
    "type": "label",
    "description": "Floating left panel\n\nVersion 3.0"
  },
  "website_btn": {
    "type": "button",
    "description": "Vist website",
    "callback": "btn_website_pressed"
  },
  "issue_btn": {
    "type": "button",
    "description": "Report an issue",
    "callback": "btn_issue_pressed"
  },
  "donate_btn": {
    "type": "button",
    "description": "Donate",
    "callback": "btn_donate_pressed"
  }
}
